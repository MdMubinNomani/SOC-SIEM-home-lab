<!--
  Custom detection rules for the SOC/SIEM home lab.
  Install path on the Wazuh manager: /var/ossec/etc/rules/local_rules.xml

  Validate before deploying:
    sudo /var/ossec/bin/wazuh-logtest
  Then reload:
    sudo systemctl restart wazuh-manager

  Rule ID range 100000-109999 is reserved for local/custom rules per Wazuh
  convention (0-99999 is reserved for Wazuh's own ruleset).
-->

<group name="local,ssh,brute_force,">
  <!--
    Fires when Wazuh's built-in rule 5716 (SSHD authentication failure)
    matches 6+ times from the same source within 120 seconds.
  -->
  <rule id="100010" level="10" frequency="6" timeframe="120">
    <if_matched_sid>5716</if_matched_sid>
    <same_source_ip />
    <description>SSH brute force attempt: multiple failed logins from the same source</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>authentication_failures,pci_dss_10.2.4,pci_dss_10.2.5,</group>
  </rule>

  <!--
    Escalation: if a successful login (5715) follows a brute-force alert
    from the same source within a short window, flag it as a likely
    compromise — this is the single highest-value alert in the whole lab.
  -->
  <rule id="100011" level="14">
    <if_matched_sid>100010</if_matched_sid>
    <if_matched_sid>5715</if_matched_sid>
    <same_source_ip />
    <description>Possible successful SSH brute force compromise (login followed brute force pattern)</description>
    <mitre>
      <id>T1110</id>
      <id>T1078</id>
    </mitre>
  </rule>
</group>

<group name="local,web,sqli,">
  <!--
    Rule 31100 is Wazuh's generic "web attack" base rule for access logs.
    We layer a regex on top looking for common SQLi indicators in the URL.
  -->
  <rule id="100020" level="12">
    <if_sid>31100</if_sid>
    <url>(?i)(union(.*)select|or 1=1|' or '1'='1|information_schema|sleep\(|--\s|;--|/\*.*\*/|xp_cmdshell)</url>
    <description>Possible SQL Injection attempt detected in web access log</description>
    <mitre>
      <id>T1190</id>
    </mitre>
    <group>web_attack,owasp_top10,</group>
  </rule>
</group>

<group name="local,recon,">
  <!--
    Rule 4501 = firewall/connection-level events (adjust if_sid to match
    whatever base rule your log source uses for accepted/denied connections,
    e.g. iptables or Metasploitable2 syslog connection entries).
  -->
  <rule id="100030" level="8" frequency="15" timeframe="20">
    <if_sid>4501</if_sid>
    <same_source_ip />
    <description>Possible port scan / network recon detected from a single source</description>
    <mitre>
      <id>T1046</id>
    </mitre>
    <group>recon,</group>
  </rule>
</group>
